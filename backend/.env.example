APP_NAME=UrbanCool AI
APP_VERSION=1.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
USE_LIVE_API=false
DATA_MODE=demo

# Google Earth Engine (optional satellite data source).
# Set USE_GEE=true once you have completed GEE setup and have a service-account key.
USE_GEE=false
GEE_PROJECT=your-cloud-project-id
GEE_SERVICE_ACCOUNT=svc@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=secrets/gee-key.json

# data.gov.in Real-time Air Quality Index API (get a free key at data.gov.in).
DATA_GOV_API_KEY=your-data-gov-in-api-key
